        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n&#39; ---------------- CNN Model ----------------\nclass CNNModel {\n  - input_shape: tuple\n  - num_classes: int\n  - model: Sequential\n  --\n  + __init__(input_shape=(128,128,3), num_classes=2)\n  + build_model(): void\n  + compile_model(loss=&#39;categorical_crossentropy&#39;, optimizer=&#39;adamw&#39;, metrics=[&#39;accuracy&#39;]): void\n}\n\nclass CNNInterface {\n  --\n  + predict_image(img): ndarray\n  + classify_image(img): str\n}\n\nCNNModel --&gt; CNNInterface : uses\n\n&#39; ---------------- U-Net Model ----------------\nclass UNetFunctions {\n  --\n  + load_images_and_masks(base_dir, img_size): tuple\n  + unet_model(input_size=(128,128,1)): Model\n  + predict_tumor_mask(image): tuple\n}\n\nclass UNetData {\n  - BASE_DIR: str\n  - IMG_SIZE: tuple\n  - MODEL_PATH: str\n  - X_train, X_val: ndarray\n  - y_train, y_val: ndarray\n  --\n  + train_test_split(): void\n  + model.fit(): void\n  + model.save(): void\n}\n\nUNetData --&gt; UNetFunctions : calls\nUNetFunctions --&gt; \&quot;U-Net Model\&quot; : builds\n\n&#39; ---------------- ResNet Model ----------------\nclass ResNetModel {\n  - base_model: ResNet50\n  - model: Model\n  - model_path: str\n  --\n  + compile(): void\n  + check_and_train(): void\n  + predict_brain_tumor(img): str\n}\n\n&#39; -------------- Relationships --------------\nCNNModel --&gt; \&quot;CNN_Model.h5\&quot; : saves to\nUNetFunctions --&gt; \&quot;UNet_Model.h5\&quot; : saves to\nResNetModel --&gt; \&quot;resnet_brain_tumor_model.h5\&quot; : saves to\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="qfTkz37L3JpKMzQMYLUj-1">
